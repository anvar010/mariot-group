# There are exactly two real env files, both gitignored:
#   .env.local  — local development (Next.js and Prisma both read it)
#   .env.live   — production, on the live server only (NODE_ENV=production)
# Copy this block into whichever one you're setting up and fill in real values.

# MySQL connection for the admin dashboard's content database.
# Local dev (XAMPP): mysql://root:@127.0.0.1:3306/mariot_admin
DATABASE_URL=

# Credentials for the /admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie — use a different one
# for .env.local vs .env.live.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
