# Copy this to .env (gitignored, never commit real values) and fill in real
# values. Local dev and production share one file and one database — see
# the note at the top of .env for what that means.

# MySQL connection for the admin dashboard's content database, as separate
# fields (see src/lib/dbConfig.ts) — some hosts only offer separate
# key/value fields for env vars, with no way to enter a full connection
# string as one value.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Credentials for the /admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Port the app listens on when started via `next start`.
PORT=3000

# Optional — where uploaded files are written. Defaults to public/uploads
# (served automatically by Next) when unset. Set this on hosts that deploy
# each build into a fresh folder, so uploads survive a redeploy.
UPLOAD_DIR=
