# Copy to .env.local and fill in real values. .env.local is gitignored.

# Credentials for the /admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# Random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# MySQL connection for the admin dashboard's content database.
# Prisma reads this from .env (project root), not .env.local — copy this
# block into .env as well. Local dev (XAMPP): mysql://root:@127.0.0.1:3306/mariot_admin
DATABASE_URL=
