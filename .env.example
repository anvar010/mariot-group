# There are exactly two real env files, both gitignored:
#   .env.local  — local development (Next.js and Prisma both read it)
#   .env.live   — production, on the live server only (NODE_ENV=production)
# Copy this block into whichever one you're setting up and fill in real values.

# MySQL connection for the admin dashboard's content database, as separate
# fields (see src/lib/dbConfig.ts) — some hosts only offer separate
# key/value fields for env vars, with no way to enter a full connection
# string as one value.
# Local dev (XAMPP): DB_HOST=127.0.0.1, DB_USER=root, DB_PASSWORD=<empty>, DB_NAME=mariot_admin
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Credentials for the /admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie — use a different one
# for .env.local vs .env.live.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
